  "decisions": [
    {
      "id": "DECISION-4af47a4a",
      "title": "Problem-first discovery",
      "text": "Complete the end-to-end flow and inspect representative report cases before choosing model orchestration or implementation stack.",
      "status": "accepted",
      "source": "MILESTONES.md; PROBLEM_ANALYSIS.md",
      "recorded_at": "2026-11-10T11:34:08.979Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "DECISION-c31279e9",
      "title": "Automatic edits require matching independent verification",
      "text": "The deterministic safety gate defaults defect edits to faculty review. It permits auto_apply only for an exact, unique, allowed edit confirmed by a separate independent edit; structural markup and MCQ answer changes remain faculty review.",
      "status": "accepted",
      "source": "scripts/safety.py; tests/test_safety.py",
      "recorded_at": "2026-11-10T11:57:02.161Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "DECISION-ece9af93",
      "title": "Use Tailwind CSS for faculty UI",
      "text": "Use Tailwind CSS for the faculty review console styling. Keep the Next.js framework choice provisional until the UI milestone; use the current official Next.js and Tailwind integration when implementing.",
      "status": "accepted",
      "source": "User instruction 2026-11-10; ASSIGNMENT_PLAN.md",
      "recorded_at": "2026-11-10T12:09:49.023Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "DECISION-27fa0d91",
      "title": "Sanity-inspired Acadza Review Desk",
      "text": "Use an editorial three-area faculty console: dark case queue, paper-like question reading canvas, and focused decision rail. Tailwind CSS implements the documented tokens and responsive layout in DESIGN.md. Keep original question and evidence central; avoid generic metric cards.",
      "status": "accepted",
      "source": "User design request 2026-11-10; DESIGN.md; https://getdesign.md/sanity/design-md",
      "recorded_at": "2026-11-10T12:15:42.084Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "DECISION-90de0ce0",
      "title": "Neon Postgres connection foundation",
      "text": "Linked the existing Acadza Reports Neon project production branch. The Next.js app uses the server-side @neondatabase/serverless HTTP driver with the pooled DATABASE_URL for a read-only connection check. LLM_API_KEY is reserved but unset. Review schema and website deployment remain in later milestones.",
      "status": "accepted",
      "source": "User request 2026-11-10; neon init/deploy output; README.md",
      "recorded_at": "2026-11-10T12:32:30.833Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "DECISION-22df50fb",
      "title": "Reconcile M2 baseline after authorized setup work",
      "text": "The owner separately requested the design document and Neon app setup while M2-SAFETY was active; these are committed in 58e250e and ce67289. They are outside M2 source scope, so rebase only M2 base_manifest to the current committed repository snapshot before closure. Keep M2 scope and its safety code unchanged. This is a harness bookkeeping correction for already authorized work.",
      "status": "accepted",
      "source": "User approval of M2 safety checks; commits 58e250e and ce67289",
      "recorded_at": "2026-11-10T12:50:28.893Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "DECISION-3dc5fad2",
      "title": "Use GPT-6 Luna for report triage",
      "text": "Use gpt-6-luna at low reasoning effort for grouped one-time triage and a separate question-only check. OpenAI currently describes it as its most efficient focused high-volume model. Never print the key; support OPENAI_API_KEY or LLM_API_KEY. Route contradictory or unresolved cases to faculty and record usage/cost estimates.",
      "status": "accepted",
      "source": "User request to use the cheaper model 2026-11-10; https://developers.openai.com/api/docs/models/gpt-6-luna; PROMPTS.md",
      "recorded_at": "2026-11-10T13:04:14.720Z",
      "paths": [],
